     {
      "type": "ia.display.label",
      "version": 0,
      "props": {
       "text": "Map Studio store checks: project mapstudio-check, connection MapStudioCheck.",
       "style": {
        "padding": "4px 12px"
       }
      },
      "meta": {
       "name": "title"
      },
      "position": {
       "basis": "auto",
       "shrink": 1
      },
      "custom": {}
