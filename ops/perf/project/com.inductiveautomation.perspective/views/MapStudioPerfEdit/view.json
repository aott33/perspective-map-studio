{
 "custom": {},
 "params": {},
 "props": {
  "defaultSize": {
   "width": 1440,
   "height": 900
  }
 },
 "root": {
  "type": "ia.container.flex",
  "version": 0,
  "props": {
   "direction": "column"
  },
  "meta": {
   "name": "root"
  },
  "position": {},
  "custom": {},
  "children": [
   {
    "type": "ia.container.flex",
    "version": 0,
    "props": {
     "direction": "row",
     "alignItems": "center",
     "wrap": "wrap"
    },
    "meta": {
     "name": "toolbar"
    },
    "position": {
     "basis": "auto",
     "shrink": 0
    },
    "custom": {},
    "children": [
     {
      "type": "ia.display.label",
      "version": 0,
      "props": {
       "text": "",
       "style": {
        "padding": "4px 12px"
       }
      },
      "meta": {
       "name": "user",
       "domId": "mapstudio-dev-user"
      },
      "position": {
       "basis": "auto",
       "shrink": 0
      },
      "custom": {},
      "propConfig": {
       "props.text": {
        "binding": {
         "type": "expr",
         "config": {
          "expression": "if({session.props.auth.authenticated}, 'Signed in as ' + {session.props.auth.user.userName}, 'Not signed in (viewer)')"
         }
        }
       }
      }
     },
     {
      "type": "ia.input.button",
      "version": 0,
      "props": {
       "text": "Log in"
      },
      "meta": {
       "name": "login",
       "domId": "mapstudio-dev-login"
      },
      "position": {
       "basis": "160px",
       "shrink": 0
      },
      "custom": {},
      "events": {
       "component": {
        "onActionPerformed": [
         {
          "config": {
           "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()"
          },
          "scope": "G",
          "type": "script"
         }
        ]
       }
      },
      "propConfig": {
       "props.text": {
        "binding": {
         "type": "expr",
         "config": {
          "expression": "if({session.props.auth.authenticated}, 'Log out', 'Log in')"
         }
        }
       }
      }
     },
     {
      "type": "ia.input.button",
      "version": 0,
      "props": {
       "text": "Time a list refresh"
      },
      "meta": {
       "name": "refresh",
       "domId": "mapstudio-perf-refresh"
      },
      "position": {
       "basis": "200px",
       "shrink": 0
      },
      "custom": {},
      "events": {
       "component": {
        "onActionPerformed": [
         {
          "config": {
           "script": "\t# Perf check (epic 2 story 17): time one system.mapstudio.refreshAdapters call on the Gateway.\n\t# mapstudio_perf.timeRefresh checks the MapEditor role itself (the scripting API trusts its caller).\n\timport java.lang\n\n\tlogger = system.util.getLogger('MapStudio.perf')\n\tout = self.view.rootContainer.getChild('refreshResult')\n\ttry:\n\t\tresult = mapstudio_perf.timeRefresh(self.session)\n\texcept java.lang.Throwable as ex:\n\t\tlogger.warn('Perf refresh failed: %s' % ex.getClass().getSimpleName())\n\t\tresult = {'error': ex.getClass().getSimpleName()}\n\texcept Exception as ex:\n\t\tlogger.warn('Perf refresh failed: %s' % type(ex).__name__)\n\t\tresult = {'error': type(ex).__name__}\n\t# ranAt tells two runs with the same result apart.\n\tresult['ranAt'] = system.date.toMillis(system.date.now())\n\tout.props.text = system.util.jsonEncode(result)"
          },
          "scope": "G",
          "type": "script"
         }
        ]
       }
      }
     }
    ]
   },
   {
    "type": "ao.mapstudio",
    "version": 0,
    "props": {},
    "meta": {
     "name": "map"
    },
    "position": {
     "basis": "0px",
     "grow": 1
    },
    "custom": {}
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "text": "",
     "style": {
      "padding": "4px 12px"
     }
    },
    "meta": {
     "name": "refreshResult",
     "domId": "mapstudio-perf-refresh-result"
    },
    "position": {
     "basis": "24px",
     "shrink": 0
    },
    "custom": {}
   }
  ]
 }
}
