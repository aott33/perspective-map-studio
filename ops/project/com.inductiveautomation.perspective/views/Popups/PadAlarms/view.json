{
 "custom": {},
 "params": {
  "mapItem": {
   "id": "",
   "name": "",
   "values": {}
  },
  "padName": "",
  "alarmsPath": ""
 },
 "propConfig": {
  "params.mapItem": {
   "paramDirection": "input",
   "persistent": true
  },
  "params.padName": {
   "paramDirection": "input",
   "persistent": true
  },
  "params.alarmsPath": {
   "paramDirection": "input",
   "persistent": true
  }
 },
 "props": {
  "defaultSize": {
   "width": 320,
   "height": 320
  }
 },
 "root": {
  "type": "ia.container.flex",
  "version": 0,
  "props": {
   "direction": "column",
   "style": {
    "padding": "8px 12px",
    "gap": "4px"
   }
  },
  "meta": {
   "name": "root"
  },
  "position": {},
  "custom": {},
  "children": [
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {
     "style": {
      "fontWeight": "bold"
     }
    },
    "meta": {
     "name": "title",
     "domId": "mapstudio-padalarms-title"
    },
    "position": {
     "basis": "24px",
     "shrink": 0
    },
    "custom": {},
    "propConfig": {
     "props.text": {
      "binding": {
       "type": "expr",
       "config": {
        "expression": "\"Alarms of \" + {view.params.padName}"
       }
      }
     }
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {},
    "meta": {
     "name": "id",
     "domId": "mapstudio-padalarms-id"
    },
    "position": {
     "basis": "24px",
     "shrink": 0
    },
    "custom": {},
    "propConfig": {
     "props.text": {
      "binding": {
       "type": "expr",
       "config": {
        "expression": "\"Id: \" + {view.params.mapItem.id}"
       }
      }
     }
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {},
    "meta": {
     "name": "pressure",
     "domId": "mapstudio-padalarms-pressure"
    },
    "position": {
     "basis": "24px",
     "shrink": 0
    },
    "custom": {},
    "propConfig": {
     "props.text": {
      "binding": {
       "type": "expr",
       "config": {
        "expression": "\"Pressure: \" + coalesce({view.params.mapItem.values.kpis.pressure.value}, \"none\")"
       }
      }
     }
    }
   },
   {
    "type": "ia.display.label",
    "version": 0,
    "props": {},
    "meta": {
     "name": "path",
     "domId": "mapstudio-padalarms-path"
    },
    "position": {
     "basis": "24px",
     "shrink": 0
    },
    "custom": {},
    "propConfig": {
     "props.text": {
      "binding": {
       "type": "expr",
       "config": {
        "expression": "\"Alarms path: \" + {view.params.alarmsPath}"
       }
      }
     }
    }
   },
   {
    "type": "ia.display.alarmstatustable",
    "version": 0,
    "props": {
     "filters": {
      "active": {
       "conditions": {
        "source": ""
       }
      }
     }
    },
    "meta": {
     "name": "alarms",
     "domId": "mapstudio-padalarms-table"
    },
    "position": {
     "basis": "0px",
     "grow": 1
    },
    "custom": {},
    "propConfig": {
     "props.filters.active.conditions.source": {
      "binding": {
       "type": "expr",
       "config": {
        "expression": "\"*\" + substring({view.params.alarmsPath}, indexOf({view.params.alarmsPath}, \"]\") + 1) + \"/*\""
       }
      }
     }
    }
   }
  ]
 }
}
