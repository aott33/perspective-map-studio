.gradle/
build/
**/build/

# Node
node_modules/
**/node_modules/
web/.gradle/

# Local settings, including the generated dev Gateway password
.env

# Staged module for the local dev Gateway
ops/modules/*.modl

# Dev Gateway write-back noise in the bind-mounted project
ops/project/**/thumbnail.png
ops/project/com.inductiveautomation.perspective/session-props/
ops/project/com.inductiveautomation.vision/

# Signing material (never committed)
ops/signing/
signing/
*.p12
*.jks
*.keystore
*.pem
*.p7b
*.modl

# IDE
.idea/
*.iml
.vscode/
bin/
.DS_Store

# Agent worktrees (parallel stories), never committed
.claude/worktrees/

# Playwright suite output (story 7); docs/ gets screenshots and measures only with E2E_DOCS=1
e2e/out/

# Dev stack secrets (generated by ops/gen_secrets.py): the PostgreSQL password, the dev API key and its resource
ops/secrets/

# Removed platform checks (story 3, removed in story 8): a developer's old generated
# PostgreSQL passwords must never be committed, so the folder stays ignored.
ops/checks/secrets/

# Python bytecode (ops/tests imports the ops scripts)
__pycache__/
